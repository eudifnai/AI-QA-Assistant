{
  "name": "@ai-qa-assistant/frontend",
  "productName": "AI QA Assistant",
  "version": "0.1.0",
  "description": "本地优先、隐私可控、可审计的 AI QA 桌面助手。",
  "author": "AI QA Assistant Contributors",
  "private": true,
  "type": "module",
  "main": ".electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "pnpm electron:install && pnpm build:electron",
    "dev": "concurrently --kill-others \"pnpm dev:web\" \"wait-on http://127.0.0.1:1420 && electron .\"",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc --build --force && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "pnpm typecheck && pnpm build:electron && vite build",
    "build:web": "vite build",
    "backend:sidecar": "uv run --project .. pyinstaller --noconfirm --clean --distpath .sidecar-dist --workpath .sidecar-build ../backend/sidecar.spec",
    "electron:install": "install-electron",
    "preelectron:package": "pnpm electron:install",
    "electron:package": "pnpm build && pnpm backend:sidecar && node electron/package-electron.cjs",
    "preelectron:make": "pnpm electron:install",
    "electron:make": "pnpm build && pnpm backend:sidecar && node electron/make-electron.cjs",
    "electron:make:from-package": "node electron/make-electron.cjs --skip-package"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "10.0.4",
    "electron": "43.3.0",
    "element-plus": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^26.0.0",
    "pinia": "^3.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0",
    "wait-on": "9.1.0"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
