# FastAPI is intentionally restricted to the IPv4 loopback interface.
AI_QA_API_HOST=127.0.0.1
AI_QA_API_PORT=8765
AI_QA_DATABASE_URL=sqlite:///./.local-data/ai_qa_assistant.db
AI_QA_DOCUMENT_MAX_BYTES=10485760
AI_QA_PROTO_MAX_BYTES=1048576
AI_QA_DOCUMENT_PARSE_TIMEOUT_SECONDS=60
AI_QA_ANALYSIS_TIMEOUT_SECONDS=300
AI_QA_MODEL_REQUEST_TIMEOUT_SECONDS=240
AI_QA_HTTP_EXECUTION_TIMEOUT_SECONDS=190
AI_QA_WEBSOCKET_EXECUTION_TIMEOUT_SECONDS=130
AI_QA_PROTOBUF_EXECUTION_TIMEOUT_SECONDS=70

# Release-build only. Keep real certificate paths and passwords in CI secrets.
AI_QA_WINDOWS_SIGN_CERTIFICATE_FILE=
AI_QA_WINDOWS_SIGN_CERTIFICATE_PASSWORD=
AI_QA_WINDOWS_SIGN_TIMESTAMP_SERVER=
